# Modèle de configuration. Copier en `.env` et renseigner les valeurs.
#   cp .env.example .env
#
# Aucune valeur réelle ne doit être committée : `.env` est ignoré par git.

# --- Django ---
DJANGO_SECRET_KEY=changez-moi-par-une-chaine-aleatoire-de-50-caracteres
DEBUG=true
ENVIRONMENT=development          # development | production
SITE_URL=http://127.0.0.1:8000

# --- Sécurité ---
# Passe la Content-Security-Policy en observation (violations signalées dans la
# console du navigateur, rien n'est bloqué). À activer quelques jours après
# l'ajout d'une origine tierce dans un gabarit, puis à remettre à false.
CSP_REPORT_ONLY=false

# --- SEO / Analytics ---
# Identifiant de mesure Google Analytics 4 (G-XXXXXXXXXX).
# Laisser vide en local et en test : aucun script de tracking n'est alors injecté.
GA_MEASUREMENT_ID=

# --- Base de données ---
# En développement, pointez sur le conteneur local (make services).
# Ne mettez JAMAIS l'URL de production ici : settings/dev.py refuse de démarrer
# sur un hôte distant, précisément pour éviter une migration accidentelle.
DB_NAME=jobpilot_db
DB_USER=jobpilot
DB_PASSWORD=changez-moi
DB_PORT_HOST=5433                # port hôte du conteneur PostgreSQL
DATABASE_URL=postgres://jobpilot:changez-moi@127.0.0.1:5433/jobpilot_db

# --- Cache partagé ---
# Obligatoire dès que gunicorn tourne avec plus d'un worker : sinon le rate
# limit Gemini et le token France Travail sont locaux à chaque processus.
REDIS_URL=redis://127.0.0.1:6379/1

# --- File de tâches (Celery) ---
# Sans broker, les tâches s'exécutent dans la requête web : c'est le
# comportement d'avant la phase 2, fonctionnel mais bloquant.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Garde-fou : empêche un poste local de se connecter à une base distante.
# À laisser commentée. Ne l'activer que ponctuellement, en lecture seule.
# ALLOW_REMOTE_DB=true

# --- France Travail ---
ID_CLIENT=
CLIENT_SECRET=
API_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PASS24H=price_...
STRIPE_PRICE_SPRINT=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PACK=price_...

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MAX_RPM=10                # requêtes/minute globales (10 pour le Free Tier)
GEMINI_FAIR_USE_LIMIT=50         # requêtes/heure par utilisateur

# --- Email ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=JobPilot-AI <noreply@jobpilot-ai.fr>

# --- Stockage Azure (production uniquement) ---
# Laisser vide en développement : les médias vont alors sur le disque local.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=media
